<?xml version="1.0"?>

<robot name="tetra" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <xacro:property name="PI" value="3.1415926" />

  <!-- Include all component files -->
  <xacro:include filename="$(find tetra_description)/urdf/materials.urdf.xacro" />
  <xacro:include filename="$(find tetra_description)/urdf/base.urdf.xacro" />
  
  <!-- Add the base and wheels -->
  <base name="base" color="black"/>
  
  <joint name="lidar" type="fixed">
    <origin xyz="0.045 0 0.17" rpy="0 0 ${-PI/2}" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>
  <link name="lidar_link" />

  <joint name="camera" type="fixed">
    <!-- camera_link = D435 depth 원점. 컬러 센서(y=0.03)는 아래 camera_color_joint (y=+0.015)로 정의 -->
    <origin xyz="0.109 0.015 0.125" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link" />
  </joint>  
  <link name="camera_link" />

  <!-- RealSense 드라이버는 depth 스트림이 꺼져 있으면 camera_link→camera_color_frame 을 NaN 으로 발행하므로
       (bringup 에서 publish_tf:=false) 컬러 프레임을 URDF 에서 직접 정의한다. D435(i) 컬러 센서는 depth 원점에서 y=+0.015 -->
  <joint name="camera_color_joint" type="fixed">
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_frame" />
  </joint>
  <link name="camera_color_frame" />

  <joint name="camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame" />
  </joint>
  <link name="camera_color_optical_frame" />

  <joint name="front_bumper" type="fixed">
    <origin xyz="0.142 0.0 -0.025" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="front_bumper_link" />
  </joint>
  <link name="front_bumper_link" />
  
</robot>


