<?xml version="1.0"?>

<robot name="tetra" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <xacro:property name="base_length" value="0.492" />
  <xacro:property name="base_radius" value="0.460" />
  <xacro:property name="wheel_offset_x" value="0.0" />
  <xacro:property name="wheel_offset_y" value="0.1975" />
  <xacro:property name="wheel_offset_z" value="0" />
     
  <!-- define a wheel -->
  <joint name="base_l_wheel_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_l_wheel_link" />
  </joint>
  <link name="base_l_wheel_link" />

  <joint name="base_r_wheel_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_r_wheel_link" />
  </joint>
  <link name="base_r_wheel_link" />

  <!-- The base xacro macro -->
  <link name="base_link">
    <visual>
      <origin xyz=" 0 0 0 " rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tetra_description/meshes/tetra_dsv_edu.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tetra_description/meshes/tetra_dsv_edu.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  
  <link name="base_footprint">
    <visual>
      <origin xyz="-0.104 0 0" rpy="0 0 0" /> 
      <geometry>
	      <box size="${base_length} ${base_radius} 0.001" />
      </geometry>
      <material name="transparentgreen" />
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <!-- Rear Caster-->
  <joint name="rear_caster_rotate_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_caster_rotate" />
    <origin xyz="-0.281 0 0.00303" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_caster_rotate" />

  <joint name="rear_caster_wheel_joint" type="fixed">
    <parent link="rear_caster_rotate" />
    <child link="rear_caster_wheel" />
    <origin xyz="-0.022 0 -0.04632" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="rear_caster_wheel" />

</robot>

